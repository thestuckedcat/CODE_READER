{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_kind": {
      "const": "review_result"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "snapshot_id",
        "input_hash",
        "issue_ids",
        "status",
        "limitations",
        "search_set",
        "correction_proposals",
        "read_set",
        "relation_proposals"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "snapshot_id": {
          "type": "string"
        },
        "input_hash": {
          "type": "string"
        },
        "issue_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "resolved",
            "candidates",
            "needs_configuration",
            "unresolved"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "search_set": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "correction_proposals": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "read_set": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "file",
              "hash",
              "start",
              "end"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "relation_proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "callsite",
              "target",
              "evidence_ids",
              "reason"
            ],
            "properties": {
              "callsite": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}